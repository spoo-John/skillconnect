# API base URL (default shown)
VITE_API_URL=https://skillconnect-backend-production.up.railway.app/api

# Public URL of this site — set before building. Used for canonical URLs, sitemap.xml, robots.txt and OG tags.
VITE_SITE_URL=https://skillconnect.app

# Plausible Analytics domain. Defaults to the host of VITE_SITE_URL. Set to an empty value to turn analytics off.
# VITE_PLAUSIBLE_DOMAIN=skillconnect.app
